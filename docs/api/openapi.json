          }
        },
        "summary": "Asset Stats Endpoint",
        "tags": [
          "assets"
        ]
      }
    },
    "/assets/{asset_id}": {
      "delete": {
        "operationId": "delete_asset_endpoint_assets__asset_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
