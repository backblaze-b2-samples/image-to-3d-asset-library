{
  "name": "image-to-3d-asset-library",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @image-to-3d-asset-library/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @image-to-3d-asset-library/web build",
    "typecheck": "pnpm --filter @image-to-3d-asset-library/web typecheck",
    "contract:export": "services/api/.venv/bin/python services/api/scripts/export_openapi.py",
    "contract:check": "services/api/.venv/bin/python services/api/scripts/export_openapi.py --check && pnpm --filter @image-to-3d-asset-library/web exec vitest run src/lib/api-contract.test.ts",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure",
    "verify:web": "pnpm lint && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @image-to-3d-asset-library/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @image-to-3d-asset-library/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "test:live:b2": "cd services/api && .venv/bin/python -m pytest live_tests/test_b2_connectivity.py -m live",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @image-to-3d-asset-library/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
